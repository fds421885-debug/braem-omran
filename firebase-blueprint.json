{
  "entities": {
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Trusted platform programmer/super-admin record keyed by Auth UID.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "quadrupleName": { "type": "string", "minLength": 3, "maxLength": 100 },
        "email": { "type": "string", "format": "email", "minLength": 3, "maxLength": 160 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "quadrupleName", "email", "createdAt"]
    },
    "NameIndexRecord": {
      "title": "NameIndexRecord",
      "description": "Unique index keyed by SHA-256 hash of normalized quadruple Arabic name to prevent duplicates.",
      "type": "object",
      "properties": {
        "accountId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["accountId", "createdBy", "createdAt"]
    },
    "DbRegistryEntry": {
      "title": "DbRegistryEntry",
      "description": "Discovery pointer for complexes and mosques linked to external Firebase databases.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 2, "maxLength": 120 },
        "hasExternalDb": { "type": "boolean" },
        "firebaseConfigJson": { "type": "string", "maxLength": 2500 },
        "mosqueConfigsJson": { "type": "string", "maxLength": 32000 },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "hasExternalDb", "firebaseConfigJson", "mosqueConfigsJson", "active", "createdAt", "updatedAt"]
    },
    "ComplexRecord": {
      "title": "ComplexRecord",
      "description": "Quranic complex containing mosques and halaqat.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 2, "maxLength": 120 },
        "usesExternalDb": { "type": "boolean" },
        "active": { "type": "boolean" },
        "createdBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "usesExternalDb", "active", "createdBy", "createdAt", "updatedAt"]
    },
    "MosqueRecord": {
      "title": "MosqueRecord",
      "description": "Mosque belonging to a Quranic complex.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "complexId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 2, "maxLength": 120 },
        "usesExternalDb": { "type": "boolean" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "complexId", "name", "usesExternalDb", "active", "createdAt", "updatedAt"]
    },
    "HalaqaRecord": {
      "title": "HalaqaRecord",
      "description": "Study circle (halaqa) inside a mosque.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "complexId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "mosqueId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 2, "maxLength": 120 },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "complexId", "mosqueId", "name", "active", "createdAt", "updatedAt"]
    },
    "AccountRecord": {
      "title": "AccountRecord",
      "description": "Member account classified as platform_admin, supervisor, teacher, or student.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "uid": { "type": "string", "maxLength": 128 },
        "quadrupleName": { "type": "string", "minLength": 3, "maxLength": 100 },
        "nameHash": { "type": "string", "minLength": 8, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "maxLength": 160 },
        "photoURL": { "type": "string", "maxLength": 500 },
        "role": { "type": "string", "enum": ["platform_admin", "supervisor", "teacher", "student"] },
        "complexId": { "type": "string", "maxLength": 128 },
        "mosqueId": { "type": "string", "maxLength": 128 },
        "mosqueIds": { "type": "array" },
        "halaqaIds": { "type": "array" },
        "inviteToken": { "type": "string", "maxLength": 128 },
        "quickToken": { "type": "string", "maxLength": 128 },
        "lastLoginDate": { "type": "string", "maxLength": 32 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "uid",
        "quadrupleName",
        "nameHash",
        "email",
        "photoURL",
        "role",
        "complexId",
        "mosqueId",
        "mosqueIds",
        "halaqaIds",
        "inviteToken",
        "quickToken",
        "lastLoginDate",
        "createdAt",
        "updatedAt"
      ]
    },
    "InviteLinkRecord": {
      "title": "InviteLinkRecord",
      "description": "Time-bounded registration invite link scoped to role, mosque(s), and halaqa(t).",
      "type": "object",
      "properties": {
        "token": { "type": "string", "minLength": 8, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 2, "maxLength": 140 },
        "complexId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "role": { "type": "string", "enum": ["supervisor", "teacher", "student"] },
        "mosqueId": { "type": "string", "maxLength": 128 },
        "mosqueIds": { "type": "array" },
        "halaqaIds": { "type": "array" },
        "startsAtMs": { "type": "integer" },
        "endsAtMs": { "type": "integer" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "token",
        "title",
        "complexId",
        "role",
        "mosqueId",
        "mosqueIds",
        "halaqaIds",
        "startsAtMs",
        "endsAtMs",
        "active",
        "createdAt",
        "updatedAt"
      ]
    },
    "QuickLinkRecord": {
      "title": "QuickLinkRecord",
      "description": "Direct quick-login link token mapped to an account.",
      "type": "object",
      "properties": {
        "token": { "type": "string", "minLength": 8, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "accountId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "quadrupleName": { "type": "string", "minLength": 3, "maxLength": 100 },
        "role": { "type": "string", "enum": ["supervisor", "teacher", "student"] },
        "complexId": { "type": "string", "maxLength": 128 },
        "complexName": { "type": "string", "maxLength": 120 },
        "mosqueId": { "type": "string", "maxLength": 128 },
        "mosqueName": { "type": "string", "maxLength": 120 },
        "halaqaNames": { "type": "array" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "token",
        "accountId",
        "quadrupleName",
        "role",
        "complexId",
        "complexName",
        "mosqueId",
        "mosqueName",
        "halaqaNames",
        "active",
        "createdAt",
        "updatedAt"
      ]
    },
    "DailyStatsRecord": {
      "title": "DailyStatsRecord",
      "description": "Daily and cumulative platform statistics.",
      "type": "object",
      "properties": {
        "dateKey": { "type": "string", "minLength": 4, "maxLength": 32 },
        "studentLogins": { "type": "integer" },
        "teacherLogins": { "type": "integer" },
        "supervisorLogins": { "type": "integer" },
        "totalVisits": { "type": "integer" },
        "recitedAyahs": { "type": "integer" },
        "recitedPages": { "type": "integer" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "dateKey",
        "studentLogins",
        "teacherLogins",
        "supervisorLogins",
        "totalVisits",
        "recitedAyahs",
        "recitedPages",
        "updatedAt"
      ]
    },
    "BookRecord": {
      "title": "BookRecord",
      "description": "Uploaded educational or Quranic book in a complex library with upload and AI recognition progress.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "complexId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "fileName": { "type": "string", "minLength": 1, "maxLength": 200 },
        "fileType": { "type": "string", "enum": ["pdf", "image"] },
        "totalPages": { "type": "integer" },
        "uploadedPages": { "type": "integer" },
        "recognizedPages": { "type": "integer" },
        "status": { "type": "string", "enum": ["uploading", "processing", "paused", "ready", "error"] },
        "createdBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "complexId",
        "title",
        "fileName",
        "fileType",
        "totalPages",
        "uploadedPages",
        "recognizedPages",
        "status",
        "createdBy",
        "createdAt",
        "updatedAt"
      ]
    },
    "BookPageRecord": {
      "title": "BookPageRecord",
      "description": "Rendered book page image and recognized Arabic/Quranic interactive word segments.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "bookId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "complexId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "pageNumber": { "type": "integer" },
        "imageDataUrl": { "type": "string", "minLength": 1, "maxLength": 700000 },
        "width": { "type": "integer" },
        "height": { "type": "integer" },
        "recognized": { "type": "boolean" },
        "fullText": { "type": "string", "maxLength": 25000 },
        "segments": { "type": "array" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "bookId",
        "complexId",
        "pageNumber",
        "imageDataUrl",
        "width",
        "height",
        "recognized",
        "fullText",
        "segments",
        "updatedAt"
      ]
    },
    "AttendanceRecord": {
      "title": "AttendanceRecord",
      "description": "Daily attendance sheet per halaqa and date.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "complexId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "mosqueId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "halaqaId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "dateKey": { "type": "string", "minLength": 8, "maxLength": 16, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "entries": { "type": "array" },
        "recordedBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "recordedByName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "complexId",
        "mosqueId",
        "halaqaId",
        "dateKey",
        "entries",
        "recordedBy",
        "recordedByName",
        "createdAt",
        "updatedAt"
      ]
    },
    "CurriculumRecord": {
      "title": "CurriculumRecord",
      "description": "Assigned book or Quran curriculum mapped to halaqat and weekly schedule days.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "complexId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "bookId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "bookTitle": { "type": "string", "minLength": 1, "maxLength": 160 },
        "halaqaIds": { "type": "array" },
        "mosqueIds": { "type": "array" },
        "days": { "type": "array" },
        "scheduleNote": { "type": "string", "maxLength": 240 },
        "active": { "type": "boolean" },
        "createdBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "complexId",
        "bookId",
        "bookTitle",
        "halaqaIds",
        "mosqueIds",
        "days",
        "scheduleNote",
        "active",
        "createdBy",
        "createdAt",
        "updatedAt"
      ]
    },
    "BookWordAudioRecord": {
      "title": "BookWordAudioRecord",
      "description": "Persisted word/ayah pronunciation WAV and Noor Al-Bayan breakdown per complex.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "complexId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "mode": { "type": "string", "enum": ["noor_albayan", "normal"] },
        "wordText": { "type": "string", "minLength": 1, "maxLength": 1200 },
        "diacritizedWord": { "type": "string", "minLength": 1, "maxLength": 1200 },
        "wasAutoDiacritized": { "type": "boolean" },
        "fullReading": { "type": "string", "maxLength": 2500 },
        "steps": { "type": "array" },
        "audioBase64": { "type": "string", "maxLength": 660000 },
        "mimeType": { "type": "string", "minLength": 1, "maxLength": 64 },
        "byteSize": { "type": "integer" },
        "createdBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "complexId",
        "mode",
        "wordText",
        "diacritizedWord",
        "wasAutoDiacritized",
        "fullReading",
        "steps",
        "audioBase64",
        "mimeType",
        "byteSize",
        "createdBy",
        "createdAt",
        "updatedAt"
      ]
    },
    "BroadcastMessageRecord": {
      "title": "BroadcastMessageRecord",
      "description": "Platform-wide or complex-scoped broadcast notifications sent by the programmer admin to selected roles.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "body": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "targetRoles": { "type": "array", "minItems": 1, "maxItems": 3 },
        "targetComplexId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "targetComplexName": { "type": "string", "maxLength": 160 },
        "senderName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "createdBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "active": { "type": "boolean" },
        "createdAtMs": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "title",
        "body",
        "targetRoles",
        "targetComplexId",
        "targetComplexName",
        "senderName",
        "createdBy",
        "active",
        "createdAtMs",
        "createdAt",
        "updatedAt"
      ]
    },
    "StudentQuranPlanRecord": {
      "title": "StudentQuranPlanRecord",
      "description": "Daily per-student Quran new hifz and reviews plan along with tomorrow assignments and carry-over.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "complexId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "mosqueId": { "type": "string", "maxLength": 128 },
        "halaqaId": { "type": "string", "maxLength": 128 },
        "studentId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "studentName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "dateKey": { "type": "string", "minLength": 8, "maxLength": 16, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "todayNew": { "type": ["object", "null"] },
        "todayReviews": { "type": "array" },
        "tomorrowNew": { "type": ["object", "null"] },
        "tomorrowReviews": { "type": "array" },
        "recordedBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "recordedByName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "complexId",
        "mosqueId",
        "halaqaId",
        "studentId",
        "studentName",
        "dateKey",
        "todayNew",
        "todayReviews",
        "tomorrowNew",
        "tomorrowReviews",
        "recordedBy",
        "recordedByName",
        "createdAt",
        "updatedAt"
      ]
    },
    "StudentMushafMistakesRecord": {
      "title": "StudentMushafMistakesRecord",
      "description": "Isolated per-student Mushaf ayah mistake counts keyed by surah:ayah.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "complexId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "studentId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "studentName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "mistakes": { "type": "object" },
        "updatedBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "complexId",
        "studentId",
        "studentName",
        "mistakes",
        "updatedBy",
        "createdAt",
        "updatedAt"
      ]
    },
    "StudentBookPlanRecord": {
      "title": "StudentBookPlanRecord",
      "description": "Daily per-student book progress position (where we reached page) plus today and tomorrow book homeworks.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "complexId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "mosqueId": { "type": "string", "maxLength": 128 },
        "halaqaId": { "type": "string", "maxLength": 128 },
        "studentId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "studentName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "bookId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "bookTitle": { "type": "string", "minLength": 1, "maxLength": 160 },
        "dateKey": { "type": "string", "minLength": 8, "maxLength": 16, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "whereWeReachedPage": { "type": "integer" },
        "todayHomeworks": { "type": "array" },
        "tomorrowHomeworks": { "type": "array" },
        "recordedBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "recordedByName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "complexId",
        "mosqueId",
        "halaqaId",
        "studentId",
        "studentName",
        "bookId",
        "bookTitle",
        "dateKey",
        "whereWeReachedPage",
        "todayHomeworks",
        "tomorrowHomeworks",
        "recordedBy",
        "recordedByName",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Trusted programmer/platform admin UID registry."
    },
    "/nameIndex/{nameHash}": {
      "schema": { "$ref": "#/entities/NameIndexRecord" },
      "description": "Unique quadruple-name hash lock preventing duplicate names."
    },
    "/dbRegistry/{complexId}": {
      "schema": { "$ref": "#/entities/DbRegistryEntry" },
      "description": "Discovery registry linking complexes/mosques/tabs to external Firebase configs."
    },
    "/complexes/{complexId}": {
      "schema": { "$ref": "#/entities/ComplexRecord" },
      "description": "Quranic complexes stored on the target database."
    },
    "/mosques/{mosqueId}": {
