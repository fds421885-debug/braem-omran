rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isPlatformAdmin() {
      return isVerifiedUser() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        || request.auth.token.email == 'hattef2022h@gmail.com'
      );
    }

    function isComplexSupervisor(cpxId) {
      return isVerifiedUser()
        && isValidId(cpxId)
        && exists(/databases/$(database)/documents/accounts/$(request.auth.uid))
        && get(/databases/$(database)/documents/accounts/$(request.auth.uid)).data.role == 'supervisor'
        && get(/databases/$(database)/documents/accounts/$(request.auth.uid)).data.complexId == cpxId;
    }

    function isComplexStaff(cpxId) {
      return isVerifiedUser()
        && isValidId(cpxId)
        && exists(/databases/$(database)/documents/accounts/$(request.auth.uid))
        && get(/databases/$(database)/documents/accounts/$(request.auth.uid)).data.role in ['supervisor', 'teacher']
        && get(/databases/$(database)/documents/accounts/$(request.auth.uid)).data.complexId == cpxId;
    }

    function isComplexMember(cpxId) {
      return isVerifiedUser()
        && isValidId(cpxId)
        && exists(/databases/$(database)/documents/accounts/$(request.auth.uid))
        && get(/databases/$(database)/documents/accounts/$(request.auth.uid)).data.complexId == cpxId;
    }

    function isBoundedStringList(arr, maxLen) {
      return arr is list
        && arr.size() <= maxLen
        && (arr.size() == 0 || (arr[0] is string && arr[0].size() <= 128));
    }

    function isValidAdmin(data, userId) {
      return data.keys().hasAll(['uid', 'quadrupleName', 'email', 'createdAt'])
        && data.keys().hasOnly(['uid', 'quadrupleName', 'email', 'createdAt'])
        && data.uid is string
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.uid == userId
        && data.quadrupleName == 'محمد منتصر محمد يونس'
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 160
        && data.createdAt is timestamp;
    }

    function isValidNameIndex(data) {
      return data.keys().hasAll(['accountId', 'createdBy', 'createdAt'])
        && data.keys().hasOnly(['accountId', 'createdBy', 'createdAt'])
        && data.accountId is string
        && isValidId(data.accountId)
        && data.createdBy is string
        && data.createdBy == request.auth.uid
        && data.createdAt is timestamp;
    }

    function isValidDbRegistry(data, complexId) {
      return data.keys().hasAll(['id', 'name', 'hasExternalDb', 'firebaseConfigJson', 'mosqueConfigsJson', 'active', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'name', 'hasExternalDb', 'firebaseConfigJson', 'mosqueConfigsJson', 'active', 'createdAt', 'updatedAt'])
        && data.id is string
        && data.id == complexId
        && isValidId(data.id)
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 120
        && data.hasExternalDb is bool
        && data.firebaseConfigJson is string && data.firebaseConfigJson.size() <= 2500
        && data.mosqueConfigsJson is string && data.mosqueConfigsJson.size() <= 32000
        && data.active is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidComplex(data, complexId) {
      return data.keys().hasAll(['id', 'name', 'usesExternalDb', 'active', 'createdBy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'name', 'usesExternalDb', 'active', 'createdBy', 'createdAt', 'updatedAt'])
        && data.id is string && data.id == complexId && isValidId(data.id)
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 120
        && data.usesExternalDb is bool
        && data.active is bool
        && data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMosque(data, mosqueId) {
      return data.keys().hasAll(['id', 'complexId', 'name', 'usesExternalDb', 'active', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'complexId', 'name', 'usesExternalDb', 'active', 'createdAt', 'updatedAt'])
        && data.id is string && data.id == mosqueId && isValidId(data.id)
        && data.complexId is string && isValidId(data.complexId)
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 120
        && data.usesExternalDb is bool
        && data.active is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidHalaqa(data, halaqaId) {
      return data.keys().hasAll(['id', 'complexId', 'mosqueId', 'name', 'active', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'complexId', 'mosqueId', 'name', 'active', 'createdAt', 'updatedAt'])
        && data.id is string && data.id == halaqaId && isValidId(data.id)
        && data.complexId is string && isValidId(data.complexId)
        && data.mosqueId is string && isValidId(data.mosqueId)
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 120
        && data.active is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAccount(data, accountId) {
      return data.keys().hasAll([
          'id', 'uid', 'quadrupleName', 'nameHash', 'email', 'photoURL',
          'role', 'complexId', 'mosqueId', 'mosqueIds', 'halaqaIds',
          'inviteToken', 'quickToken', 'lastLoginDate', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'uid', 'quadrupleName', 'nameHash', 'email', 'photoURL',
          'role', 'complexId', 'mosqueId', 'mosqueIds', 'halaqaIds',
          'inviteToken', 'quickToken', 'lastLoginDate', 'createdAt', 'updatedAt'
        ])
        && data.id is string && data.id == accountId && isValidId(data.id)
        && data.uid is string && data.uid.size() <= 128
        && data.quadrupleName is string && data.quadrupleName.size() >= 3 && data.quadrupleName.size() <= 100
        && data.nameHash is string && isValidId(data.nameHash)
        && data.email is string && data.email.size() <= 160
        && data.photoURL is string && data.photoURL.size() <= 500
        && data.role in ['platform_admin', 'supervisor', 'teacher', 'student']
        && data.complexId is string && data.complexId.size() <= 128
        && data.mosqueId is string && data.mosqueId.size() <= 128
        && isBoundedStringList(data.mosqueIds, 50)
        && isBoundedStringList(data.halaqaIds, 50)
        && data.inviteToken is string && data.inviteToken.size() <= 128
        && data.quickToken is string && data.quickToken.size() <= 128
        && data.lastLoginDate is string && data.lastLoginDate.size() <= 32
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidInviteLink(data, token) {
      return data.keys().hasAll([
          'token', 'title', 'complexId', 'role', 'mosqueId',
          'mosqueIds', 'halaqaIds', 'startsAtMs', 'endsAtMs',
          'active', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'token', 'title', 'complexId', 'role', 'mosqueId',
          'mosqueIds', 'halaqaIds', 'startsAtMs', 'endsAtMs',
          'active', 'createdAt', 'updatedAt'
        ])
        && data.token is string && data.token == token && isValidId(data.token)
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 140
        && data.complexId is string && isValidId(data.complexId)
        && data.role in ['supervisor', 'teacher', 'student']
        && data.mosqueId is string && data.mosqueId.size() <= 128
        && isBoundedStringList(data.mosqueIds, 50)
        && isBoundedStringList(data.halaqaIds, 50)
        && data.startsAtMs is int && data.startsAtMs >= 0
        && data.endsAtMs is int && data.endsAtMs >= 0
        && data.active is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidQuickLink(data, token) {
      return data.keys().hasAll([
          'token', 'accountId', 'quadrupleName', 'role',
          'complexId', 'complexName', 'mosqueId', 'mosqueName',
          'halaqaNames', 'active', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'token', 'accountId', 'quadrupleName', 'role',
          'complexId', 'complexName', 'mosqueId', 'mosqueName',
          'halaqaNames', 'active', 'createdAt', 'updatedAt'
        ])
        && data.token is string && data.token == token && isValidId(data.token)
        && data.accountId is string && isValidId(data.accountId)
        && data.quadrupleName is string && data.quadrupleName.size() >= 3 && data.quadrupleName.size() <= 100
        && data.role in ['supervisor', 'teacher', 'student']
        && data.complexId is string && data.complexId.size() <= 128
        && data.complexName is string && data.complexName.size() <= 120
        && data.mosqueId is string && data.mosqueId.size() <= 128
        && data.mosqueName is string && data.mosqueName.size() <= 120
        && isBoundedStringList(data.halaqaNames, 50)
        && data.active is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidStats(data) {
      return data.keys().hasAll([
          'dateKey', 'studentLogins', 'teacherLogins', 'supervisorLogins',
          'totalVisits', 'recitedAyahs', 'recitedPages', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'dateKey', 'studentLogins', 'teacherLogins', 'supervisorLogins',
          'totalVisits', 'recitedAyahs', 'recitedPages', 'updatedAt'
        ])
        && data.dateKey is string && data.dateKey.size() >= 4 && data.dateKey.size() <= 32
        && data.studentLogins is int && data.studentLogins >= 0 && data.studentLogins <= 10000000
        && data.teacherLogins is int && data.teacherLogins >= 0 && data.teacherLogins <= 10000000
        && data.supervisorLogins is int && data.supervisorLogins >= 0 && data.supervisorLogins <= 10000000
        && data.totalVisits is int && data.totalVisits >= 0 && data.totalVisits <= 100000000
        && data.recitedAyahs is int && data.recitedAyahs >= 0 && data.recitedAyahs <= 100000000
        && data.recitedPages is int && data.recitedPages >= 0 && data.recitedPages <= 10000000
        && data.updatedAt is timestamp;
    }

    function isValidBook(data, bookId) {
      return data.keys().hasAll([
          'id', 'complexId', 'title', 'fileName', 'fileType',
          'totalPages', 'uploadedPages', 'recognizedPages', 'status',
          'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'complexId', 'title', 'fileName', 'fileType',
          'totalPages', 'uploadedPages', 'recognizedPages', 'status',
          'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.id is string && data.id == bookId && isValidId(data.id)
        && data.complexId is string && isValidId(data.complexId)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && data.fileName is string && data.fileName.size() >= 1 && data.fileName.size() <= 200
        && data.fileType in ['pdf', 'image']
        && data.totalPages is int && data.totalPages >= 1 && data.totalPages <= 2000
        && data.uploadedPages is int && data.uploadedPages >= 0 && data.uploadedPages <= 2000
        && data.recognizedPages is int && data.recognizedPages >= 0 && data.recognizedPages <= 2000
        && data.status in ['uploading', 'processing', 'paused', 'ready', 'error']
        && data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBookPage(data, pageId) {
      return data.keys().hasAll([
          'id', 'bookId', 'complexId', 'pageNumber', 'imageDataUrl',
          'width', 'height', 'recognized', 'fullText', 'segments', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'bookId', 'complexId', 'pageNumber', 'imageDataUrl',
          'width', 'height', 'recognized', 'fullText', 'segments', 'updatedAt'
        ])
        && data.id is string && data.id == pageId && isValidId(data.id)
        && data.bookId is string && isValidId(data.bookId)
        && data.complexId is string && isValidId(data.complexId)
        && data.pageNumber is int && data.pageNumber >= 1 && data.pageNumber <= 2000
        && data.imageDataUrl is string && data.imageDataUrl.size() >= 1 && data.imageDataUrl.size() <= 750000
        && data.width is int && data.width >= 1 && data.width <= 10000
        && data.height is int && data.height >= 1 && data.height <= 10000
        && data.recognized is bool
        && data.fullText is string && data.fullText.size() <= 25000
        && data.segments is list && data.segments.size() <= 500
        && (data.segments.size() == 0 || data.segments[0] is map)
        && data.updatedAt is timestamp;
    }

    function isValidWordAudio(data, audioId) {
      return data.keys().hasAll([
          'id', 'complexId', 'mode', 'wordText', 'diacritizedWord',
          'wasAutoDiacritized', 'fullReading', 'steps', 'audioBase64',
          'mimeType', 'byteSize', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'complexId', 'mode', 'wordText', 'diacritizedWord',
          'wasAutoDiacritized', 'fullReading', 'steps', 'audioBase64',
          'mimeType', 'byteSize', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.id is string && data.id == audioId && isValidId(data.id)
        && data.complexId is string && isValidId(data.complexId)
        && data.mode in ['noor_albayan', 'normal']
        && data.wordText is string && data.wordText.size() >= 1 && data.wordText.size() <= 1200
        && data.diacritizedWord is string && data.diacritizedWord.size() >= 1 && data.diacritizedWord.size() <= 1200
        && data.wasAutoDiacritized is bool
        && data.fullReading is string && data.fullReading.size() <= 2500
        && data.steps is list && data.steps.size() <= 60
        && (data.steps.size() == 0 || data.steps[0] is map)
        && data.audioBase64 is string && data.audioBase64.size() <= 660000
        && data.mimeType is string && data.mimeType.size() >= 1 && data.mimeType.size() <= 64
        && data.byteSize is int && data.byteSize >= 0 && data.byteSize <= 1048576
        && data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAttendance(data, recordId) {
      return data.keys().hasAll([
          'id', 'complexId', 'mosqueId', 'halaqaId', 'dateKey',
          'entries', 'recordedBy', 'recordedByName', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'complexId', 'mosqueId', 'halaqaId', 'dateKey',
          'entries', 'recordedBy', 'recordedByName', 'createdAt', 'updatedAt'
        ])
        && data.id is string && data.id == recordId && isValidId(data.id)
        && data.complexId is string && isValidId(data.complexId)
        && data.mosqueId is string && isValidId(data.mosqueId)
        && data.halaqaId is string && isValidId(data.halaqaId)
        && data.dateKey is string && data.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.entries is list && data.entries.size() <= 200
        && (data.entries.size() == 0 || data.entries[0] is map)
        && data.recordedBy is string && data.recordedBy.size() >= 1 && data.recordedBy.size() <= 128
        && data.recordedByName is string && data.recordedByName.size() >= 1 && data.recordedByName.size() <= 120
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCurriculum(data, curriculumId) {
      return data.keys().hasAll([
          'id', 'complexId', 'bookId', 'bookTitle', 'halaqaIds',
          'mosqueIds', 'days', 'scheduleNote', 'active', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'complexId', 'bookId', 'bookTitle', 'halaqaIds',
          'mosqueIds', 'days', 'scheduleNote', 'active', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.id is string && data.id == curriculumId && isValidId(data.id)
        && data.complexId is string && isValidId(data.complexId)
        && data.bookId is string && isValidId(data.bookId)
        && data.bookTitle is string && data.bookTitle.size() >= 1 && data.bookTitle.size() <= 160
        && isBoundedStringList(data.halaqaIds, 100)
        && data.halaqaIds.size() >= 1
        && isBoundedStringList(data.mosqueIds, 50)
        && isBoundedStringList(data.days, 7)
        && data.days.size() >= 1
        && data.scheduleNote is string && data.scheduleNote.size() <= 240
        && data.active is bool
        && data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBroadcast(data, broadcastId) {
      return data.keys().hasAll([
          'id', 'title', 'body', 'targetRoles', 'targetComplexId',
          'targetComplexName', 'senderName', 'createdBy', 'active',
          'createdAtMs', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'title', 'body', 'targetRoles', 'targetComplexId',
          'targetComplexName', 'senderName', 'createdBy', 'active',
          'createdAtMs', 'createdAt', 'updatedAt'
        ])
        && data.id is string && data.id == broadcastId && isValidId(data.id)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && data.body is string && data.body.size() >= 1 && data.body.size() <= 4000
        && data.targetRoles is list
        && data.targetRoles.size() >= 1 && data.targetRoles.size() <= 3
        && data.targetRoles.hasOnly(['supervisor', 'teacher', 'student'])
        && data.targetComplexId is string && data.targetComplexId.size() >= 1 && data.targetComplexId.size() <= 128
        && data.targetComplexName is string && data.targetComplexName.size() <= 160
        && data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 120
        && data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128
        && data.active is bool
        && data.createdAtMs is int && data.createdAtMs >= 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /admins/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if false;
      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isValidAdmin(incoming(), userId)
        && incoming().createdAt == request.time;
      allow update, delete: if false;
    }

    match /nameIndex/{nameHash} {
      allow get: if isSignedIn() && isValidId(nameHash);
      allow list: if false;
      allow create: if isVerifiedUser()
        && isValidId(nameHash)
        && isValidNameIndex(incoming())
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isPlatformAdmin() || (
        isVerifiedUser()
        && exists(/databases/$(database)/documents/accounts/$(request.auth.uid))
        && get(/databases/$(database)/documents/accounts/$(request.auth.uid)).data.role == 'supervisor'
      );
    }

    match /dbRegistry/{complexId} {
      allow get: if isValidId(complexId);
      allow list: if resource.data.active == true;
      allow create: if isPlatformAdmin()
        && isValidId(complexId)
        && isValidDbRegistry(incoming(), complexId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isPlatformAdmin()
        && isValidId(complexId)
        && isValidDbRegistry(incoming(), complexId)
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'hasExternalDb', 'firebaseConfigJson', 'mosqueConfigsJson', 'active', 'updatedAt'
        ]);
      allow delete: if isPlatformAdmin() && isValidId(complexId);
    }

    match /complexes/{complexId} {
      allow get: if isSignedIn() && isValidId(complexId);
      allow list: if isSignedIn() && resource.data.active == true;
      allow create: if isPlatformAdmin()
        && isValidId(complexId)
        && isValidComplex(incoming(), complexId)
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isPlatformAdmin()
        && isValidId(complexId)
        && isValidComplex(incoming(), complexId)
        && incoming().id == existing().id
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'usesExternalDb', 'active', 'updatedAt']);
      allow delete: if isPlatformAdmin() && isValidId(complexId);
    }

    match /mosques/{mosqueId} {
      allow get: if isSignedIn() && isValidId(mosqueId);
      allow list: if isSignedIn() && resource.data.active == true;
      allow create: if (isPlatformAdmin() || isComplexSupervisor(incoming().complexId))
        && isValidId(mosqueId)
        && isValidMosque(incoming(), mosqueId)
        && incoming().usesExternalDb == false
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if (
          isPlatformAdmin()
          || (
            isComplexSupervisor(existing().complexId)
            && incoming().complexId == existing().complexId
            && incoming().usesExternalDb == existing().usesExternalDb
          )
        )
        && isValidId(mosqueId)
        && isValidMosque(incoming(), mosqueId)
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['complexId', 'name', 'usesExternalDb', 'active', 'updatedAt']);
      allow delete: if isPlatformAdmin() && isValidId(mosqueId);
    }

    match /halaqat/{halaqaId} {
      allow get: if isSignedIn() && isValidId(halaqaId);
      allow list: if isSignedIn() && resource.data.active == true;
      allow create: if (isPlatformAdmin() || isComplexSupervisor(incoming().complexId))
        && isValidId(halaqaId)
        && isValidHalaqa(incoming(), halaqaId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if (
          isPlatformAdmin()
          || (
            isComplexSupervisor(existing().complexId)
            && incoming().complexId == existing().complexId
          )
        )
        && isValidId(halaqaId)
        && isValidHalaqa(incoming(), halaqaId)
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['complexId', 'mosqueId', 'name', 'active', 'updatedAt']);
      allow delete: if isPlatformAdmin() && isValidId(halaqaId);
    }

    match /accounts/{accountId} {
      allow get: if isSignedIn() && isValidId(accountId) && (
        isPlatformAdmin()
        || existing().uid == request.auth.uid
        || existing().email == request.auth.token.email
        || (existing().complexId is string && isComplexSupervisor(existing().complexId))
      );
      allow list: if isSignedIn() && (
        isPlatformAdmin()
        || resource.data.uid == request.auth.uid
        || resource.data.email == request.auth.token.email
        || (resource.data.complexId is string && isComplexSupervisor(resource.data.complexId))
      );

      allow create: if isVerifiedUser()
        && isValidId(accountId)
        && isValidAccount(incoming(), accountId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          isPlatformAdmin()
          || (
            isComplexSupervisor(incoming().complexId)
            && incoming().role in ['supervisor', 'teacher', 'student']
          )
          || (
            incoming().uid == request.auth.uid
            && incoming().email == request.auth.token.email
            && (
              incoming().role == 'student'
              || (incoming().role == 'platform_admin' && incoming().quadrupleName == 'محمد منتصر محمد يونس')
              || (
                incoming().inviteToken is string
                && incoming().inviteToken.size() >= 8
                && exists(/databases/$(database)/documents/inviteLinks/$(incoming().inviteToken))
              )
            )
          )
        );

      allow update: if isVerifiedUser()
        && isValidId(accountId)
        && isValidAccount(incoming(), accountId)
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isPlatformAdmin()
          || (
            isComplexSupervisor(existing().complexId)
            && incoming().complexId == existing().complexId
            && existing().role in ['supervisor', 'teacher', 'student']
            && incoming().role in ['supervisor', 'teacher', 'student']
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'quadrupleName', 'nameHash', 'role', 'mosqueId', 'mosqueIds', 'halaqaIds', 'quickToken', 'updatedAt'
            ])
          )
          || (
            existing().uid == ''
            && incoming().uid == request.auth.uid
            && incoming().email == request.auth.token.email
            && incoming().diff(existing()).affectedKeys().hasOnly(['uid', 'email', 'photoURL', 'lastLoginDate', 'updatedAt'])
          )
          || (
            existing().uid == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['photoURL', 'lastLoginDate', 'updatedAt'])
          )
        );

      allow delete: if isValidId(accountId) && (
        isPlatformAdmin()
        || (
          existing().role in ['supervisor', 'teacher', 'student']
          && existing().uid != request.auth.uid
          && existing().complexId is string
          && isComplexSupervisor(existing().complexId)
        )
      );
    }

    match /inviteLinks/{token} {
      allow get: if isValidId(token);
      allow list: if isSignedIn() && resource.data.active is bool && (
        isPlatformAdmin() || isComplexSupervisor(resource.data.complexId)
      );
      allow create: if (isPlatformAdmin() || isComplexSupervisor(incoming().complexId))
        && isValidId(token)
        && isValidInviteLink(incoming(), token)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if (
          isPlatformAdmin()
          || (isComplexSupervisor(existing().complexId) && incoming().complexId == existing().complexId)
        )
        && isValidId(token)
        && isValidInviteLink(incoming(), token)
        && incoming().token == existing().token
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'complexId', 'role', 'mosqueId', 'mosqueIds', 'halaqaIds', 'startsAtMs', 'endsAtMs', 'active', 'updatedAt'
        ]);
      allow delete: if isValidId(token) && (
        isPlatformAdmin() || isComplexSupervisor(existing().complexId)
      );
    }

    match /quickLinks/{token} {
      allow get: if isValidId(token);
      allow list: if isSignedIn() && resource.data.active is bool && (
        isPlatformAdmin() || isComplexSupervisor(resource.data.complexId)
      );
      allow create: if (isPlatformAdmin() || isComplexSupervisor(incoming().complexId))
        && isValidId(token)
        && isValidQuickLink(incoming(), token)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if (
          isPlatformAdmin()
          || (isComplexSupervisor(existing().complexId) && incoming().complexId == existing().complexId)
        )
        && isValidId(token)
        && isValidQuickLink(incoming(), token)
        && incoming().token == existing().token
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'accountId', 'quadrupleName', 'role', 'complexId', 'complexName', 'mosqueId', 'mosqueName', 'halaqaNames', 'active', 'updatedAt'
        ]);
      allow delete: if isValidId(token) && (
        isPlatformAdmin() || isComplexSupervisor(existing().complexId)
      );
    }

    match /stats/{statId} {
      allow get: if isSignedIn() && isValidId(statId);
      allow list: if isSignedIn() && resource.data.totalVisits is int && (
        isPlatformAdmin()
        || (
          exists(/databases/$(database)/documents/accounts/$(request.auth.uid))
          && get(/databases/$(database)/documents/accounts/$(request.auth.uid)).data.role == 'supervisor'
        )
      );
      allow create: if isVerifiedUser()
        && isValidId(statId)
        && isValidStats(incoming())
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(statId)
        && isValidStats(incoming())
        && incoming().dateKey == existing().dateKey
        && incoming().updatedAt == request.time
        && (
          (
            isPlatformAdmin()
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'studentLogins', 'teacherLogins', 'supervisorLogins', 'totalVisits', 'recitedAyahs', 'recitedPages', 'updatedAt'
            ])
          )
          || (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'studentLogins', 'teacherLogins', 'supervisorLogins', 'totalVisits', 'updatedAt'
            ])
            && incoming().studentLogins >= existing().studentLogins && incoming().studentLogins <= existing().studentLogins + 1
            && incoming().teacherLogins >= existing().teacherLogins && incoming().teacherLogins <= existing().teacherLogins + 1
            && incoming().supervisorLogins >= existing().supervisorLogins && incoming().supervisorLogins <= existing().supervisorLogins + 1
            && incoming().totalVisits >= existing().totalVisits && incoming().totalVisits <= existing().totalVisits + 1
          )
        );
      allow delete: if false;
    }

    match /books/{bookId} {
      allow get: if isSignedIn() && isValidId(bookId) && (
        isPlatformAdmin() || isComplexSupervisor(existing().complexId)
      );
      allow list: if isSignedIn() && (
        isPlatformAdmin()
        || (resource.data.complexId is string && isComplexSupervisor(resource.data.complexId))
      );
      allow create: if (isPlatformAdmin() || isComplexSupervisor(incoming().complexId))
        && isValidId(bookId)
        && isValidBook(incoming(), bookId)
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if (
          isPlatformAdmin()
          || (isComplexSupervisor(existing().complexId) && incoming().complexId == existing().complexId)
        )
        && isValidId(bookId)
        && isValidBook(incoming(), bookId)
        && incoming().id == existing().id
        && incoming().complexId == existing().complexId
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'totalPages', 'uploadedPages', 'recognizedPages', 'status', 'updatedAt'
        ]);
      allow delete: if isValidId(bookId) && (
        isPlatformAdmin() || isComplexSupervisor(existing().complexId)
      );
    }

    match /bookPages/{pageId} {
      allow get: if isSignedIn() && isValidId(pageId) && (
        isPlatformAdmin() || isComplexSupervisor(existing().complexId)
      );
      allow list: if isSignedIn() && (
        isPlatformAdmin()
        || (resource.data.complexId is string && isComplexSupervisor(resource.data.complexId))
      );
      allow create: if (isPlatformAdmin() || isComplexSupervisor(incoming().complexId))
        && isValidId(pageId)
        && isValidBookPage(incoming(), pageId)
        && incoming().updatedAt == request.time;
      allow update: if (
          isPlatformAdmin()
          || (isComplexSupervisor(existing().complexId) && incoming().complexId == existing().complexId)
        )
        && isValidId(pageId)
        && isValidBookPage(incoming(), pageId)
        && incoming().id == existing().id
        && incoming().bookId == existing().bookId
        && incoming().complexId == existing().complexId
        && incoming().pageNumber == existing().pageNumber
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'imageDataUrl', 'width', 'height', 'recognized', 'fullText', 'segments', 'updatedAt'
        ]);
      allow delete: if isValidId(pageId) && (
        isPlatformAdmin() || isComplexSupervisor(existing().complexId)
      );
    }

    match /wordAudio/{audioId} {
      allow get: if isSignedIn() && isValidId(audioId) && (
        isPlatformAdmin() || isComplexMember(existing().complexId)
      );
      allow list: if isSignedIn() && (
        isPlatformAdmin()
        || (resource.data.complexId is string && isComplexMember(resource.data.complexId))
      );
      allow create: if (isPlatformAdmin() || isComplexMember(incoming().complexId))
        && isValidId(audioId)
        && isValidWordAudio(incoming(), audioId)
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if (
          isPlatformAdmin()
          || (isComplexMember(existing().complexId) && incoming().complexId == existing().complexId)
        )
        && isValidId(audioId)
        && isValidWordAudio(incoming(), audioId)
        && incoming().id == existing().id
        && incoming().complexId == existing().complexId
        && incoming().mode == existing().mode
        && incoming().wordText == existing().wordText
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'diacritizedWord', 'wasAutoDiacritized', 'fullReading', 'steps',
          'audioBase64', 'mimeType', 'byteSize', 'updatedAt'
        ]);
      allow delete: if isValidId(audioId) && (
        isPlatformAdmin() || isComplexSupervisor(existing().complexId)
      );
    }

    match /attendance/{recordId} {
      allow get: if isSignedIn() && isValidId(recordId) && (
        isPlatformAdmin() || isComplexStaff(existing().complexId)
      );
      allow list: if isSignedIn() && (
        isPlatformAdmin()
        || (resource.data.complexId is string && isComplexStaff(resource.data.complexId))
      );
      allow create: if (isPlatformAdmin() || isComplexStaff(incoming().complexId))
        && isValidId(recordId)
        && isValidAttendance(incoming(), recordId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if (
          isPlatformAdmin()
          || (isComplexStaff(existing().complexId) && incoming().complexId == existing().complexId)
        )
        && isValidId(recordId)
        && isValidAttendance(incoming(), recordId)
        && incoming().id == existing().id
        && incoming().complexId == existing().complexId
        && incoming().mosqueId == existing().mosqueId
        && incoming().halaqaId == existing().halaqaId
        && incoming().dateKey == existing().dateKey
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'entries', 'recordedBy', 'recordedByName', 'updatedAt'
        ]);
      allow delete: if isValidId(recordId) && (
        isPlatformAdmin() || isComplexSupervisor(existing().complexId)
      );
    }

    match /curricula/{curriculumId} {
      allow get: if isSignedIn() && isValidId(curriculumId) && (
        isPlatformAdmin() || isComplexStaff(existing().complexId)
      );
      allow list: if isSignedIn() && (
        isPlatformAdmin()
        || (resource.data.complexId is string && isComplexStaff(resource.data.complexId))
      );
      allow create: if (isPlatformAdmin() || isComplexSupervisor(incoming().complexId))
        && isValidId(curriculumId)
        && isValidCurriculum(incoming(), curriculumId)
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if (
          isPlatformAdmin()
          || (isComplexSupervisor(existing().complexId) && incoming().complexId == existing().complexId)
        )
        && isValidId(curriculumId)
        && isValidCurriculum(incoming(), curriculumId)
        && incoming().id == existing().id
        && incoming().complexId == existing().complexId
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'bookId', 'bookTitle', 'halaqaIds', 'mosqueIds', 'days', 'scheduleNote', 'active', 'updatedAt'
        ]);
      allow delete: if isValidId(curriculumId) && (
        isPlatformAdmin() || isComplexSupervisor(existing().complexId)
      );
    }

    match /broadcasts/{broadcastId} {
      allow get: if isValidId(broadcastId) && (
        resource.data.active == true || isPlatformAdmin()
      );
      allow list: if resource.data.active == true || isPlatformAdmin();
      allow create: if isPlatformAdmin()
        && isValidId(broadcastId)
        && isValidBroadcast(incoming(), broadcastId)
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isPlatformAdmin()
        && isValidId(broadcastId)
        && isValidBroadcast(incoming(), broadcastId)
        && incoming().id == existing().id
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'body', 'targetRoles', 'targetComplexId', 'targetComplexName',
          'active', 'updatedAt'
        ]);
      allow delete: if isPlatformAdmin() && isValidId(broadcastId);
    }
  }
}
